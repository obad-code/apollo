# Secrets. The whole point of this file.
.env
.env.*
!.env.example

# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Downloaded models and generated audio - big, and re-fetchable.
voices/
voicebox_samples/

# Screenshot harness output
_frames/

# Windows shell cruft
Thumbs.db
desktop.ini

# Local runtime state
reminders.json
.thumbnail

# Plan execution scratch
.superpowers/

# Company marks, cached at runtime. Other companies trademarks, fetched from
# a third party - not ours to keep in the history.
ui/full/logos/

# Keys and credentials, whatever they end up called.
*.pem
*.key
*.pfx
*.p12
*.token
secrets.*
credentials*.json

# Build and tool output.
build/
dist/
*.egg-info/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
probes/shots/

# This machine's own Claude Code permissions - not the project's.
.claude/settings.local.json
